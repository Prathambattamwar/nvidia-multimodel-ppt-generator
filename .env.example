# Copy to .env. Never commit your real API key.
PORT=3000
HOST=127.0.0.1
APP_BASE_URL=http://localhost:3000

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Verify the selected models are enabled for your NVIDIA API account.
NVIDIA_TEXT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Fast direct responses: avoid spending the output-token budget on reasoning
NVIDIA_DISABLE_THINKING=true
# Image comparison uses a vision-capable model separately.
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_REVIEW_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Image strategy: try Google HTTP search, then no-key Wikimedia Commons API fallback (no Chromium).
# Your PSE ID is used for the Google attempt; Wikimedia Commons is the automatic fallback.
IMAGE_PROVIDER=google_pse
# Optional extra Google CSE IDs separated by commas/semicolons/spaces; built-in 10 IDs rotate automatically.
PSE_CX_ROTATION=
PSE_CX=31e897332f91f4804
# Optional: add a Custom Search JSON API key if your Google account already has access.
PSE_API_KEY=
PSE_ENGINE_COOLDOWN_MS=3600000
IMAGE_SEARCH_RESULTS=3
IMAGE_SEARCH_MAX_BYTES=1500000
IMAGE_SEARCH_TIMEOUT_MS=2200
IMAGE_SEARCH_AI_ANALYSIS=false

# Request/retry settings
NVIDIA_MAX_RETRIES=0
NVIDIA_TIMEOUT_RETRIES=0
NVIDIA_RETRY_BASE_MS=1200
NVIDIA_REQUEST_TIMEOUT_MS=25000
# Draft small batches to avoid long single-response timeouts
NVIDIA_DRAFT_BATCH_SIZE=3
MAX_CONCURRENT_GENERATIONS=10
ENABLE_REVIEW=false
MAX_SLIDES=12
MAX_PROMPT_LENGTH=12000

# Persistence
DATABASE_PATH=./data/app.sqlite
DATA_DIR=./data
